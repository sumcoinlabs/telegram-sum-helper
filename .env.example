# Create a bot with Telegram @BotFather; never commit actual credentials.
TELEGRAM_BOT_TOKEN=
ALLOWED_CHAT_USERNAME=sumcoins
# Stronger than a username; obtain from /chatid once the bot is in the group.
ALLOWED_CHAT_ID=
# Default is safe observation; /mode reply enables natural-language support replies.
# For group-wide message delivery, configure BotFather privacy or minimal bot-admin role.
# Enroll @SumcoinAdmin by sending /start to the bot in a private chat.
INITIAL_MODE=observe
STATE_FILE=./data/state.json
# Private chats are off by default (prevents outsiders from using your AI quota).
ALLOW_PRIVATE_CHATS=false
# Safe default: OFF, even if someone fills in OPENAI_API_KEY.
# ChatGPT Plus is separate; API calls require eligible promotional credits or API billing.
AI_ENABLED=false
# Three independent, persisted limits. Zero disables API calls entirely.
AI_HOURLY_LIMIT=4
AI_DAILY_LIMIT=12
AI_MONTHLY_LIMIT=60
# Even these counters do NOT guarantee a $0 bill. Use an API project spend limit
# and do not add a payment method if you want promotional-credits-only use.
WEEKLY_REPORT_ENABLED=false
# Automatic questions use free verified answers. AI is only for /ask, direct replies or @mentions.
AUTO_AI=false
# Required for conversational AI; without this key /ask uses grounded extractive search.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Optional with an API key; restricted sources only, always review before announcing updates.
# Knowledge sync: npm run sync
USER_COOLDOWN_HOURS=6
TOPIC_COOLDOWN_SECONDS=120
# Redacted recurring question patterns are saved for 30 days. No sender IDs.
LEARNING_ENABLED=true

# Leave off to store hashed question fingerprints/counts, NOT message examples.
LEARNING_STORE_EXAMPLES=false

# Persistent redacted review queue; lives in the ignored data/ directory.
ESCALATION_FILE=./data/escalations.json

# Private 90-day relevant group message index (only one authorized group).
GROUP_INDEX_ENABLED=true
GROUP_INDEX_FILE=./data/group-index.json
# Optional comma-separated numeric IDs of trusted non-admin contributors.
# Their replies create *drafts*, never automatically approved knowledge.
TRUSTED_DEVELOPER_IDS=
