{
  "name": "telegram-sum-helper",
  "version": "0.0.12",
  "private": true,
  "description": "Grounded, multilingual, continuously improving Sumcoin Telegram support bot",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "start": "node --env-file=.env src/index.js",
